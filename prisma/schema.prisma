generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserType {
  MAHASISWA
  DOSEN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGIN_DEVICE_REJECTED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_CREATED
  ACCOUNT_ACTIVATED
  ACCOUNT_DEACTIVATED
  SESSION_REVOKED
}

enum ReportCategory {
  FASILITAS
  KEBERSIHAN
  KEAMANAN
  KEHILANGAN
  KEBIJAKAN
  LAINNYA
  LAPORAN_GRUP
}

enum ReportStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ReportVisibility {
  PUBLIC
  ANONYMOUS
  PRIVATE
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  userType     UserType?
  fotoProfil   String?
  jurusan      String?
  bio          String?
  trustScore   Int       @default(0)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Kolom baru untuk fitur single-device session (nullable — tidak memengaruhi data lama)
  activeSessionId String?
  lastSeenAt      DateTime?
  activeDevice    String?

  reports       Report[]
  reportSupports ReportSupport[]
  createdGroups Group[] @relation("GroupCreator")
  groupMemberships GroupMember[] @relation("GroupMembershipUser")
  groupMessages GroupMessage[] @relation("GroupMessageSender")
  statusChanges ReportStatusHistory[] @relation("ReportStatusChangedBy")
  forumPosts    ForumPost[]
  forumLikes    ForumPostLike[]
  forumComments ForumComment[]
  sentFriendRequests     FriendRequest[] @relation("FriendRequestRequester")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")
  adminNews              AdminNews[]
}

model LoginThrottle {
  key         String    @id
  attempts    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id             Int         @id @default(autoincrement())
  createdAt      DateTime    @default(now())
  action         AuditAction
  actorId        Int?
  actorUsername  String?
  targetId       Int?
  targetUsername String?
  ip             String?
  userAgent      String?
  metadata       Json?

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

// ── SafeCampus ──────────────────────────────────────────────

model Report {
  id              Int              @id @default(autoincrement())
  // Alamat halaman laporan (/laporan/<slug>); dibuat dari judul + 6 karakter acak dan tidak berubah saat judul diedit.
  slug            String           @unique
  title           String
  description     String
  location        String
  category        ReportCategory
  status          ReportStatus     @default(UNVERIFIED)
  visibility      ReportVisibility @default(PUBLIC)
  occurredAt      DateTime         @db.Date
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Identitas pelapor selalu disimpan, termasuk untuk laporan ANONYMOUS,
  // agar moderator/admin dapat menindaklanjuti penyalahgunaan.
  // Penyembunyian nama dilakukan pada lapisan query (lihat src/modules/report/rules.ts).
  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  groupId  Int?
  group    Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  photos   ReportPhoto[]
  @@index([groupId])
  history  ReportStatusHistory[]
  supports ReportSupport[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model ReportPhoto {
  id        Int      @id @default(autoincrement())
  reportId  Int
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([reportId])
}

model ForumPost {
  id          Int       @id @default(autoincrement())
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  images      ForumPostImage[]
  audios      ForumPostAudio[]
  likes       ForumPostLike[]
  comments    ForumComment[]

  @@index([createdAt])
  @@index([authorId])
}

model ForumPostImage {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  publicId  String    @unique
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())

  @@index([postId])
}

model ForumPostAudio {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  publicId  String    @unique
  format    String?
  bytes     Int?
  createdAt DateTime  @default(now())

  @@index([postId])
}

model ForumPostLike {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model ForumComment {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  text      String
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

model FriendRequest {
  id          Int                 @id @default(autoincrement())
  requesterId Int
  requester   User                @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId Int
  recipient   User                @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([requesterId, recipientId])
  @@index([requesterId, status])
  @@index([recipientId, status])
}

model ReportStatusHistory {
  id          Int           @id @default(autoincrement())
  reportId    Int
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus  ReportStatus?
  toStatus    ReportStatus
  note        String?
  changedById Int?
  changedBy   User?         @relation("ReportStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([reportId])
}

// Dukungan ("Bantu Laporan"): satu pengguna hanya boleh mendukung satu laporan satu kali.
model ReportSupport {
  id        Int      @id @default(autoincrement())
  reportId  Int
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([userId])
}

// ── Grup ─────────────────────────────────────────────────────

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

model Group {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  photo       String?
  visibility  GroupVisibility @default(PRIVATE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creatorId   Int
  creator     User @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  members     GroupMember[]
  messages    GroupMessage[]
  reports     Report[]

  @@index([creatorId])
}

model GroupMember {
  id        Int             @id @default(autoincrement())
  groupId   Int
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation("GroupMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role      GroupMemberRole  @default(MEMBER)
  joinedAt  DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User     @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([groupId, createdAt])
  @@index([senderId])
}

model AdminNews {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([authorId])
}
