generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserType {
  MAHASISWA
  DOSEN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGIN_DEVICE_REJECTED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_ACTIVATED
  ACCOUNT_DEACTIVATED
  SESSION_REVOKED
  TRUST_MODERATION
}

enum ReportCategory {
  FASILITAS
  KEBERSIHAN
  KEAMANAN
  KEHILANGAN
  KEBIJAKAN
  LAINNYA
  LAPORAN_GRUP
  LAPORAN_EVENT
}

enum ReportStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  IN_PROGRESS
  RESOLVED
}

enum ReportVisibility {
  PUBLIC
  ANONYMOUS
  PRIVATE
}

enum TrustTransactionType {
  EARN
  REVERSAL
  PENALTY
  ADJUSTMENT
  SUSPENSION
  RESTORATION
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  name         String
  nickname     String?
  email        String?   @unique
  passwordHash String
  role         Role      @default(USER)
  userType     UserType?
  fotoProfil   String?
  jurusan      String?
  bio          String?
  trustScore   Int       @default(0)
  isProfilePrivate Boolean @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Kolom baru untuk fitur single-device session (nullable — tidak memengaruhi data lama)
  activeSessionId String?
  lastSeenAt      DateTime?
  activeDevice    String?

  reports       Report[]
  reportSupports ReportSupport[]
  listings       Listing[]
  createdGroups Group[] @relation("GroupCreator")
  groupMemberships GroupMember[] @relation("GroupMembershipUser")
  groupJoinRequests GroupJoinRequest[] @relation("GroupJoinRequestUser")
  groupMessages GroupMessage[] @relation("GroupMessageSender")
  statusChanges ReportStatusHistory[] @relation("ReportStatusChangedBy")
  forumPosts    ForumPost[]
  forumLikes    ForumPostLike[]
  forumComments ForumComment[]
  forumCommentMentions ForumCommentMention[] @relation("ForumCommentMentionUser")
  forumPostMentions ForumPostMention[] @relation("ForumPostMentionUser")
  forumPollVotes ForumPollVote[]
  sentFriendRequests     FriendRequest[] @relation("FriendRequestRequester")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")
  adminNews              AdminNews[]
  trustTransactions      TrustTransaction[] @relation("TrustTransactionUser")
  trustTransactionsCreated TrustTransaction[] @relation("TrustTransactionCreator")
  trustMilestones        TrustMilestone[]
  trustDailyEarnings     TrustDailyEarning[]
  trustXpSuspensions     TrustXpSuspension[]
  createdEvents           Event[]               @relation("EventCreator")
  eventParticipations     EventParticipant[]
  eventInterests          EventInterest[]
}

// Trust Level ledger: amount is signed; positive adds XP and negative removes XP.
// The application must create this row and update User.trustScore atomically.
model TrustTransaction {
  id                    Int                  @id @default(autoincrement())
  userId                Int
  user                  User                 @relation("TrustTransactionUser", fields: [userId], references: [id], onDelete: Restrict)
  amount                Int
  type                  TrustTransactionType
  source                String
  sourceId              String
  originalTransactionId Int?                 @unique
  originalTransaction   TrustTransaction?    @relation("TrustTransactionReversal", fields: [originalTransactionId], references: [id], onDelete: Restrict)
  reversal              TrustTransaction?    @relation("TrustTransactionReversal")
  suspensionEarnings    TrustXpSuspension[]  @relation("TrustSuspensionEarn")
  suspensionTransactions TrustXpSuspension[] @relation("TrustSuspensionTransaction")
  suspensionRestorations TrustXpSuspension[] @relation("TrustSuspensionRestoration")
  milestone             TrustMilestone?
  createdById           Int?
  createdBy             User?                @relation("TrustTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())

  @@unique([userId, type, source, sourceId])
  @@index([userId, createdAt])
  @@index([source, sourceId])
}

// Links a suspended Thread earning with its optional restoration.
model TrustXpSuspension {
  id                       Int               @id @default(autoincrement())
  earnTransactionId        Int
  earnTransaction          TrustTransaction  @relation("TrustSuspensionEarn", fields: [earnTransactionId], references: [id], onDelete: Restrict)
  suspensionTransactionId  Int               @unique
  suspensionTransaction    TrustTransaction  @relation("TrustSuspensionTransaction", fields: [suspensionTransactionId], references: [id], onDelete: Restrict)
  restorationTransactionId Int?              @unique
  restorationTransaction   TrustTransaction? @relation("TrustSuspensionRestoration", fields: [restorationTransactionId], references: [id], onDelete: Restrict)
  userId                   Int
  user                     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt                DateTime          @default(now())
  restoredAt                DateTime?
}

// Records completed one-time milestones independently from the XP ledger.
model TrustMilestone {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  milestone           String
  transactionId       Int      @unique
  transaction         TrustTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  completedAt         DateTime @default(now())

  @@unique([userId, milestone])
}

// Cached daily EARN total for Asia/Jakarta. Updated atomically with its ledger row.
model TrustDailyEarning {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  date      DateTime @db.Date
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model LoginThrottle {
  key         String    @id
  attempts    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id             Int         @id @default(autoincrement())
  createdAt      DateTime    @default(now())
  action         AuditAction
  actorId        Int?
  actorUsername  String?
  targetId       Int?
  targetUsername String?
  ip             String?
  userAgent      String?
  metadata       Json?

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

// ── SafeCampus ──────────────────────────────────────────────

model Report {
  id              Int              @id @default(autoincrement())
  // Alamat halaman laporan (/laporan/<slug>); dibuat dari judul + 6 karakter acak dan tidak berubah saat judul diedit.
  slug            String           @unique
  title           String
  description     String
  location        String
  category        ReportCategory
  status          ReportStatus     @default(UNVERIFIED)
  visibility      ReportVisibility @default(PUBLIC)
  occurredAt      DateTime         @db.Date
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Identitas pelapor selalu disimpan, termasuk untuk laporan ANONYMOUS,
  // agar moderator/admin dapat menindaklanjuti penyalahgunaan.
  // Penyembunyian nama dilakukan pada lapisan query (lihat src/modules/report/rules.ts).
  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  groupId  Int?
  group    Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  photos   ReportPhoto[]
  @@index([groupId])
  history  ReportStatusHistory[]
  supports ReportSupport[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model ReportPhoto {
  id        Int      @id @default(autoincrement())
  reportId  Int
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([reportId])
}

model ForumPost {
  id          Int       @id @default(autoincrement())
  text        String
  tag         String?
  locationLabel String?
  locationUrl String?
  latitude    Float?
  longitude   Float?
  eventTitle  String?
  eventDate   String?
  eventTime   String?
  eventLocation String?
  eventUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  images      ForumPostImage[]
  audios      ForumPostAudio[]
  likes       ForumPostLike[]
  comments    ForumComment[]
  mentions   ForumPostMention[]
  poll        ForumPoll?

  @@index([createdAt])
  @@index([authorId])
}

model ForumPostMention {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation("ForumPostMentionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model ForumPoll {
  id        Int              @id @default(autoincrement())
  postId    Int              @unique
  post      ForumPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  question  String
  options   ForumPollOption[]
  votes     ForumPollVote[]
  createdAt DateTime         @default(now())
}

model ForumPollOption {
  id        Int            @id @default(autoincrement())
  pollId    Int
  poll      ForumPoll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  votes     ForumPollVote[]
  createdAt DateTime       @default(now())

  @@index([pollId])
}

model ForumPollVote {
  id        Int            @id @default(autoincrement())
  pollId    Int
  poll      ForumPoll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  Int
  option    ForumPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([pollId, userId])
  @@index([optionId])
  @@index([userId])
}

model ForumPostImage {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  publicId  String    @unique
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())

  @@index([postId])
}

model ForumPostAudio {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  publicId  String    @unique
  format    String?
  bytes     Int?
  createdAt DateTime  @default(now())

  @@index([postId])
}

model ForumPostLike {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  trustEligible Boolean  @default(true)

  @@unique([postId, userId])
  @@index([userId])
}

model ForumComment {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      Int
  author        User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentId      Int?
  parent        ForumComment? @relation("ForumCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ForumComment[] @relation("ForumCommentReplies")
  text          String
  createdAt     DateTime  @default(now())
  trustEligible Boolean   @default(true)
  mentions      ForumCommentMention[]

  @@index([postId, createdAt])
  @@index([postId, parentId, createdAt])
  @@index([authorId])
}

model ForumCommentMention {
  id        Int          @id @default(autoincrement())
  commentId Int
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation("ForumCommentMentionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model FriendRequest {
  id          Int                 @id @default(autoincrement())
  requesterId Int
  requester   User                @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId Int
  recipient   User                @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([requesterId, recipientId])
  @@index([requesterId, status])
  @@index([recipientId, status])
}

model ReportStatusHistory {
  id          Int           @id @default(autoincrement())
  reportId    Int
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus  ReportStatus?
  toStatus    ReportStatus
  note        String?
  changedById Int?
  changedBy   User?         @relation("ReportStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([reportId])
}

// Dukungan ("Bantu Laporan"): satu pengguna hanya boleh mendukung satu laporan satu kali.
model ReportSupport {
  id        Int      @id @default(autoincrement())
  reportId  Int
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([userId])
}

// ── Grup ─────────────────────────────────────────────────────

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupJoinRequestStatus {
  PENDING
  REJECTED
}

enum GroupMessageType {
  USER
  SYSTEM
}

model Group {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  photo       String?
  visibility  GroupVisibility @default(PRIVATE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creatorId   Int
  creator     User @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  members       GroupMember[]
  joinRequests  GroupJoinRequest[]
  messages      GroupMessage[]
  reports       Report[]
  events        Event[]

  @@index([creatorId])
}

model GroupMember {
  id        Int             @id @default(autoincrement())
  groupId   Int
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation("GroupMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role      GroupMemberRole  @default(MEMBER)
  joinedAt  DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupJoinRequest {
  id        Int                    @id @default(autoincrement())
  groupId   Int
  group     Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User                   @relation("GroupJoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  status    GroupJoinRequestStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId, status])
}

model GroupMessage {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User     @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?
  isSystem  Boolean  @default(false)

  @@index([groupId, createdAt])
  @@index([senderId])
}

model AdminNews {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([authorId])
}


// ── Marketplace (Forum Jual Beli) ───────────────────────────

enum ListingCategory {
  BOOKS
  ELECTRONICS
  FASHION
  VEHICLES
  BOARDING_HOUSE
  SERVICES
  FOOD
  OTHER
}

enum ListingCondition {
  NEW
  USED
}

enum ListingAvailability {
  AVAILABLE
  LIMITED
  SOLD
}

model Listing {
  id            Int                 @id @default(autoincrement())
  // Alamat halaman tawaran (/marketplace/<slug>); judul + akhiran acak, tidak berubah saat judul diedit.
  slug          String              @unique
  title         String
  description   String
  // Rupiah utuh. BigInt karena batas harga aplikasi (100 miliar) melebihi batas Int 32-bit PostgreSQL (2,1 miliar).
  price         BigInt
  category      ListingCategory
  condition     ListingCondition
  availability  ListingAvailability @default(AVAILABLE)
  location      String
  // Preferensi penjualan; minimal salah satu harus true (dijaga constraint di database).
  allowCod      Boolean             @default(true)
  allowShipping Boolean             @default(false)
  // false = dinonaktifkan penjual: tidak tampil di daftar umum, tetap ada di Menu Jual.
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  sellerId Int
  seller   User @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  photos ListingPhoto[]

  @@index([sellerId])
  @@index([isActive, createdAt])
  @@index([category])
}

model ListingPhoto {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([listingId])
}
