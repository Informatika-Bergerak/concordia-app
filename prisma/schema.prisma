generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserType {
  MAHASISWA
  DOSEN
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGIN_DEVICE_REJECTED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_CREATED
  ACCOUNT_ACTIVATED
  ACCOUNT_DEACTIVATED
  SESSION_REVOKED
}

enum ReportCategory {
  FASILITAS
  KEBERSIHAN
  KEAMANAN
  KEHILANGAN
  KEBIJAKAN
  LAINNYA
}

enum ReportStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ReportVisibility {
  PUBLIC
  ANONYMOUS
  PRIVATE
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  userType     UserType?
  fotoProfil   String?
  jurusan      String?
  trustScore   Int       @default(0)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Kolom baru untuk fitur single-device session (nullable — tidak memengaruhi data lama)
  activeSessionId String?
  lastSeenAt      DateTime?
  activeDevice    String?

  reports       Report[]
  statusChanges ReportStatusHistory[] @relation("ReportStatusChangedBy")
}

model LoginThrottle {
  key         String    @id
  attempts    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id             Int         @id @default(autoincrement())
  createdAt      DateTime    @default(now())
  action         AuditAction
  actorId        Int?
  actorUsername  String?
  targetId       Int?
  targetUsername String?
  ip             String?
  userAgent      String?
  metadata       Json?

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

// ── SafeCampus ──────────────────────────────────────────────

model Report {
  id              Int              @id @default(autoincrement())
  title           String
  description     String
  location        String
  category        ReportCategory
  status          ReportStatus     @default(UNVERIFIED)
  visibility      ReportVisibility @default(PUBLIC)
  occurredAt      DateTime         @db.Date
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Identitas pelapor selalu disimpan, termasuk untuk laporan ANONYMOUS,
  // agar moderator/admin dapat menindaklanjuti penyalahgunaan.
  // Penyembunyian nama dilakukan pada lapisan query (lihat src/modules/report/rules.ts).
  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  photos  ReportPhoto[]
  history ReportStatusHistory[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model ReportPhoto {
  id        Int      @id @default(autoincrement())
  reportId  Int
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([reportId])
}

model ReportStatusHistory {
  id          Int           @id @default(autoincrement())
  reportId    Int
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus  ReportStatus?
  toStatus    ReportStatus
  note        String?
  changedById Int?
  changedBy   User?         @relation("ReportStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([reportId])
}
